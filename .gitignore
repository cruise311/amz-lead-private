# .gitignore
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
.env

# Distribution / packaging
dist/
build/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Project specific
configs/settings.local.yaml
configs/*.local.yaml
logs/
*.log
data/
tmp/
temp/

# Testing
.coverage.*
coverage.xml
*.cover

# Type checking
*.pyc
.typeguard/

# Playwright
playwright-report/
test-results/

# OS
Thumbs.db
ehthumbs.db
Desktop.ini

# Spyder
.spyderproject
.spyproject

# pyenv
.python-version

# pipenv
Pipfile.lock

# poetry
poetry.lock

# hatch
.hatch/

# pdm
.pdm.toml